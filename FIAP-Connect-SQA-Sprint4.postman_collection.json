{
  "info": {
    "_postman_id": "900fa77c-8627-4597-b40e-402b0a5f6e7d",
    "name": "Automacao de testes da API .NET do FIAP Connect Sprint 4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "55182014",
    "_collection_link": "https://go.postman.co/collection/55182014-900fa77c-8627-4597-b40e-402b0a5f6e7d?source=collection_link"
  },
  "item": [
    {
      "name": "01 - Login (gerar JWT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code eh 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contem token JWT nao vazio\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.token).to.be.a(\"string\").and.to.not.be.empty;\r",
              "});\r",
              "\r",
              "pm.test(\"Response contem rm canonico (RM560384)\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.rm).to.eql(\"RM560384\");\r",
              "});\r",
              "\r",
              "pm.test(\"Tempo de resposta menor que 5 segundos\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
              "});\r",
              "\r",
              "// Salva o JWT no environment pra usar nos proximos requests\r",
              "const json = pm.response.json();\r",
              "if (json.token) {\r",
              "    pm.environment.set(\"jwt\", json.token);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"idToken\": \"{{idToken}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 - Criar Notificacao",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code eh 201 Created\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contem id ObjectId valido (24 chars hex)\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.id).to.match(/^[a-f0-9]{24}$/);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contem rmDestinatario canonizado\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.rmDestinatario).to.eql(\"RM560384\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response contem tipo enviado\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.tipo).to.eql(\"TESTE_AUTOMACAO_POSTMAN\");\r",
              "});\r",
              "\r",
              "pm.test(\"Origem da notificacao eh DOTNET\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.origem).to.eql(\"DOTNET\");\r",
              "});\r",
              "\r",
              "// Salva o ID da notificacao criada pra usar no proximo request\r",
              "const json = pm.response.json();\r",
              "if (json.id) {\r",
              "    pm.environment.set(\"notificacaoId\", json.id);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"rmDestinatario\": \"RM560384\",\r\n  \"tipo\": \"TESTE_AUTOMACAO_POSTMAN\",\r\n  \"titulo\": \"Notificacao criada via Postman\",\r\n  \"mensagem\": \"Teste automatizado para SQA Sprint 4\",\r\n  \"prioridade\": \"NORMAL\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/notificacoes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notificacoes"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03 - Listar Notificacoes",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code eh 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response tem estrutura de paginacao\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json).to.have.property(\"itens\");\r",
              "    pm.expect(json).to.have.property(\"pagina\");\r",
              "    pm.expect(json).to.have.property(\"tamanhoPagina\");\r",
              "    pm.expect(json).to.have.property(\"totalItens\");\r",
              "    pm.expect(json).to.have.property(\"totalPaginas\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response tem links HATEOAS\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.links).to.be.an(\"array\");\r",
              "    pm.expect(json.links.length).to.be.at.least(1);\r",
              "    \r",
              "    const linkSelf = json.links.find(l => l.rel === \"self\");\r",
              "    pm.expect(linkSelf).to.not.be.undefined;\r",
              "    pm.expect(linkSelf.href).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "pm.test(\"Itens sao todos do destinatario filtrado (RM560384)\", function () {\r",
              "    const json = pm.response.json();\r",
              "    json.itens.forEach(notificacao => {\r",
              "        pm.expect(notificacao.rmDestinatario).to.eql(\"RM560384\");\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Notificacao criada no request anterior aparece na lista\", function () {\r",
              "    const json = pm.response.json();\r",
              "    const idEsperado = pm.environment.get(\"notificacaoId\");\r",
              "    const encontrada = json.itens.find(n => n.id === idEsperado);\r",
              "    pm.expect(encontrada).to.not.be.undefined;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notificacoes?rmDestinatario=RM560384&pagina=1&tamanhoPagina=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notificacoes"
          ],
          "query": [
            {
              "key": "rmDestinatario",
              "value": "RM560384"
            },
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "tamanhoPagina",
              "value": "10"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "04 - Deletar Notificacao",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code eh 204 No Content\", function () {\r",
              "    pm.response.to.have.status(204);\r",
              "});\r",
              "\r",
              "pm.test(\"Response body eh vazio\", function () {\r",
              "    pm.expect(pm.response.text()).to.be.empty;\r",
              "});\r",
              "\r",
              "pm.test(\"Tempo de resposta menor que 5 segundos\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notificacoes/{{notificacaoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notificacoes",
            "{{notificacaoId}}"
          ]
        }
      },
      "response": []
    }
  ]
}